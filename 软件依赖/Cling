#!/bin/ksh

软件名称=Cling
软件版本=1.3

资源链接[Cling.tar.gz]="https://github.com/root-project/cling/archive/refs/tags/v${软件版本}.tar.gz"
终端命令=(cling)
运行路径[cling]=

配置部署() {

cd "$ROOT"
rm --recursive --force 代码

cd "$ROOT/临时"
tar --extract --file Cling.tar.gz --directory .
mv cling-${软件版本} "$ROOT/代码"

cd "$ROOT/代码"
mkdir llvm-build && cd llvm-build
cmake -DLLVM_ENABLE_PROJECTS="clang" -DLLVM_TARGETS_TO_BUILD="host;NVPTX" -DCMAKE_BUILD_TYPE=Release ../llvm-project/llvm
cmake --build .

}