#!/bin/env ksh

软件名称=ChineseKornShell
软件版本=5.3

终端命令=(shcomp)
运行路径[ksh]=容器/bin/ksh
运行路径[shcomp]=容器/bin/shcomp

配置部署() {

cd "$ROOT"
mkdir --parents 容器
mkdir --parents 代码

cd "$ROOT/代码"
同步仓库 https://github.com/Afiredream/ChineseKornShell.git
bin/package make
bin/package install "$ROOT/容器"
bin/package clean

}