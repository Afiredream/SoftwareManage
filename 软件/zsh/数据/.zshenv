#!/bin/env zsh
fpath=("$ROOTDIR/share/zsh/functions")

alias 别名=alias
别名 如果=if
别名 结束=fi
别名 进入=cd
别名 遍历=in
别名 进行=do
别名 设置=set
别名 对于=for
别名 否则=else
别名 或者=elif
别名 退出=exit
别名 回显=echo
别名 运行=exec
别名 那么=then
别名 完成=done
别名 弹栈=popd
别名 压栈=pushd
别名 跳出=break
别名 循环=while
别名 本地=local
别名 取消=unset
别名 打印=print
别名 配置=setopt
别名 导出=export
别名 导入=source
别名 继续=continue
别名 函数=function
别名 位移=shift


导出 是=1
导出 否=0
导出 真=1
导出 假=0
