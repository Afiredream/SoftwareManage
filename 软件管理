#!/bin/ksh

运行命令="$1"

脚本路径="$(realpath "$0")"
起始路径="$(dirname "${脚本路径}")"

方式列表="${起始路径}/运行方式"
数据仓库="${起始路径}/数据仓库"
共享文件="${起始路径}/共享文件"
软件列表="${起始路径}/软件列表"

cd "${起始路径}"
git fetch --all

if [[ "${运行命令}" == "运行" ]];then
    
    软件目录="$ROOT"
    软件运行="${软件目录}/运行"
    软件配置="${软件目录}/配置"
    临时目录="${软件目录}/临时"
    容器目录="${软件目录}/容器"
    
    [[ -f "${软件运行}" ]] || { echo "缺少运行文件:${软件运行}";exit; }
    [[ -f "${软件配置}" ]] || { echo "缺少配置文件:${软件配置}";exit; }
    
    [[ -f "${软件配置}" ]] && source "${软件配置}"
    软件路径="${软件列表}/${软件名称}"
    [[ -d "${软件路径}" ]] && cp --recursive --force "${软件路径}/." "${软件目录}"
    cp --recursive --force "${共享文件}/." "${软件目录}"

    [[ -f "${软件配置}" ]] && source "${软件配置}"
    运行参数=()
    ( 更新检查 ) &
    配置部署
    运行环境

    运行路径="$ROOT/${运行路径}"
    if [[ "${图标路径}" != https://* ]];then
        ln --symbolic --force "${图标路径}" "$ROOT/图标"
    fi
    chmod +x "${方式列表}/${运行方式}"
    exec "${方式列表}/${运行方式}" "${运行路径}" "${运行参数[@]}"

fi

if [[ "${运行命令}" == "部署" ]];then

    软件名称="$2"
    软件目录="$PWD/${软件名称}"
    软件运行="${软件目录}/运行"
    软件路径="${软件列表}/${软件名称}"
    
    [[ -z "${软件名称}" ]] && { echo "缺少参数软件名称: 软件管理 部署 软件名称";exit; }
    [[ -d "${软件目录}" ]] && { echo "软件已经存在请勿重复部署软件:${软件名称}";exit; }
    [[ -d "${软件路径}" ]] || { echo "软件列表里面没有找到这个软件:${软件名称}";exit; }

    mkdir --parents "${软件目录}"
    cp --recursive --force "${软件路径}"/* "${软件目录}"
    cp --recursive --force "${共享文件}"/* "${软件目录}"
    chmod +x "${软件运行}"

fi
