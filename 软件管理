#!/bin/ksh

运行命令="$1"

起始路径="$(dirname "$0")"
数据仓库="${起始路径}/数据仓库"

if [[ "${运行命令}" == "运行" ]];then
    [[ -f "$ROOT/运行" ]] || { echo "缺少运行文件:$ROOT/运行";exit; }
    [[ -f "$ROOT/配置" ]] || { echo "缺少配置文件:$ROOT/配置";exit; }
    source "$ROOT/配置"
    [[ "${运行路径}" != /* ]] && 运行路径="$ROOT/${运行路径}"
    cd "$ROOT" && git fetch --all
    exec "$(dirname "$0")/运行方式/${运行方式}" "${运行路径}"
fi

if [[ "${运行命令}" == "下载" ]];then
    软件名称="$2"
    [[ -z "${软件名称}" ]] && { echo "缺少参数软件名称: 软件管理 下载 软件名称";exit; }
    软件仓库="$(键值 索引 "${数据仓库}" "${软件名称}")"
    [[ -z "${软件仓库}" ]] && { echo "数据仓库没有找到这个软件:${软件名称}";exit; }
    git clone "${软件仓库}" "$PWD/${软件名称}"
    [[ -d "$PWD/${软件名称}" ]] || { echo "软件下载失败需要重新下载:${软件名称}";exit; }
fi
