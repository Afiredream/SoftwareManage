#!/bin/env zsh

软件="$*"
文件="$(realpath $0)"
数据=$(eval 回显 ~$USER)
运行="$(dirname "${文件}")"
目录="$(dirname "${运行}")"
名称="$(basename "${文件}")"

导出 PATH="${目录}/脚本:$PATH"
导出 软件目录="${数据}/软件/软件仓库/${软件}"

typeset -A 资源链接
typeset -A 运行路径

如果 [[ -e "${目录}/列表/${软件}" ]]; 那么
    导入 "${目录}/列表/${软件}"
否则
    回显 "数据仓库没有这个软件:${软件}" 
    退出 0
结束

对于 依赖名称 in "${部署依赖[@]}"; 进行
    [[ -z "${依赖名称}" ]] && 跳出
    回显 "正在装载依赖:${依赖名称}"
    软件更新 "${依赖名称}" > /dev/null
完成

回显 "正在装载软件:${软件}"

mkdir --parents "${软件目录}"
ln --symbolic --force --relative --no-dereference "${数据}/软件/系统配置" "${软件目录}/系统"
    

对于 文件名称 in "${(@k)资源链接[@]}"; 进行
    [[ -z "${文件名称}" ]] && 继续
    创建目录 "${软件目录}/临时"
    进入 "${软件目录}/临时"
    文件链接="${资源链接[${文件名称}]}"
    [[ -z "${文件链接}" ]] && 继续
    [[ -e "${软件目录}/临时/${文件名称}" ]] || curl --fail --location --output "${软件目录}/临时/${文件名称}" "${文件链接}" --verbose
完成

配置部署

对于 运行名称 in "${(@k)运行路径[@]}"; 进行
    创建目录 "${软件目录}/运行"
    运行路径="${运行路径[${运行名称}]}"
    如果 [[ -z "${运行路径}" ]]; 那么
        运行路径=
    或者 [[ "${运行路径}" == /* ]]; 那么
        运行路径="${运行路径}"
    否则
        运行路径='${目录}'"/${运行路径}"
    结束
    回显 '#!/bin/env zsh' > "${软件目录}/运行/${运行名称}"
    回显 '文件="$(realpath "$0")"' >> "${软件目录}/运行/${运行名称}"
    回显 '运行="$(dirname "$文件")"' >> "${软件目录}/运行/${运行名称}"
    回显 '目录="$(dirname "$运行")"' >> "${软件目录}/运行/${运行名称}"
    回显 '列表="$(dirname "$目录")"' >> "${软件目录}/运行/${运行名称}"
    回显 '名称="$(basename "$文件")"' >> "${软件目录}/运行/${运行名称}"
    对于 软件名称 in "${运行依赖[@]}"; 进行
        [[ -z "${软件名称}" ]] && 继续
        回显 '导出 PATH="${列表}/'"${软件名称}"'/运行:$PATH"' >> "${软件目录}/运行/${运行名称}"
    完成
    对于 软件名称 in "${动态链接[@]}"; 进行
        [[ -z "${软件名称}" ]] && 继续
        回显 '导出 LD_LIBRARY_PATH="${列表}/'"${软件名称}"'/共享:$LD_LIBRARY_PATH"' >> "${软件目录}/运行/${运行名称}"
    完成
    [[ -e "${软件目录}/容器/lib" ]] && 回显 '导出 LD_LIBRARY_PATH="${目录}/容器/lib:$LD_LIBRARY_PATH"' >> "${软件目录}/运行/${运行名称}"
    [[ -e "${软件目录}/数据" ]] && 回显 '导出 HOME="${目录}/数据"' >> "${软件目录}/运行/${运行名称}"
    [[ -f "${软件目录}/配置/${运行名称}" ]] && 回显 '导入 "${目录}/配置/${名称}"' >> "${软件目录}/运行/${运行名称}"
    如果 [[ -f "${软件目录}/钩子/${运行名称}" ]]; 那么
        回显 "${运行路径}"' "$@"' >> "${软件目录}/运行/${运行名称}"
        回显 '导入 "${目录}/钩子/${名称}"' >> "${软件目录}/运行/${运行名称}"
    否则
        [[ -z "${运行方式}" ]] && 回显 '运行 "'"${运行路径}"'" "$@"' >> "${软件目录}/运行/${运行名称}"
        [[ -n "${运行方式}" ]] && 回显 '运行 '"${运行方式}"' "'"${运行路径}"'" "$@"' >> "${软件目录}/运行/${运行名称}"
    结束
    给予运行权限 "${软件目录}/运行/${运行名称}"
完成

对于 运行名称 in "${运行列表[@]}"; 进行
    ln --symbolic --force --relative "${软件目录}/运行/${运行名称}" "${数据}/软件/软件运行/${运行名称}"
完成

[[ -n "${软件版本}" ]] && 回显 "${软件版本}" > "${软件目录}/版本"


回显 "软件装载完成:${软件}"