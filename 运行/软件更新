#!/bin/env zsh

软件="$*"
文件="$(realpath $0)"
数据=$(eval 回显 ~$USER)
运行="$(dirname "${文件}")"
目录="$(dirname "${运行}")"
名称="$(basename "${文件}")"

导出 PATH="${目录}/脚本:$PATH"
导出 软件目录="${数据}/软件/列表/${软件}"

typeset -A 资源链接
typeset -A 运行路径

if [[ -e "${目录}/列表/${软件}" ]]; then
    source "${目录}/列表/${软件}"
else
    echo "数据仓库没有这个软件:${软件}" 
    exit
fi

对于 依赖名称 in "${部署依赖[@]}"; 进行
    [[ -z "${依赖名称}" ]] && 跳出
    回显 "正在装载依赖:${依赖名称}"
    软件更新 "${依赖名称}" > /dev/null
完成

回显 "正在装载软件:${软件}"

# 带进度条下载：总大小取 HEAD 的 content-length（或 Content-Range 的总长）；
# 用 --range 从“已下”处续传，每段每秒刷新进度，走 stderr，不影响外层的 > /dev/null。
# 静态检查注意：脚本依赖中文别名（如果/那么/或者/完成…），只做 zsh -n 会误报。
带进度下载() {

local 链接="$1" 目标="$2" 下载目录="${2}.下载中" 段头= 大小= 进度文件 已下 本地已下 百分比 宽度=28 条 状态码
local -i 起点=0 序号=0 下载进程

预览="$(curl --silent --show-error --location --head --connect-timeout 10 --max-time 30 -- "${链接}" </dev/null)" || 预览=
头数组=("${(@f)预览}")
local 头
for 头 in "${头数组[@]}"; do
    头="${头%$'\r'}"
    if [[ "${头:l}" == 'content-length:'* ]]; then
        大小="${${头#*:}//[[:space:]]/}"
    fi
done

回显 "下载:${链接##*/}（${大小:+$(( 大小 / 1024 / 1024 ))} MB）" >&2

rm --recursive --force -- "${下载目录}"
mkdir --parents -- "${下载目录}"
while :; do
    进度文件="${下载目录}/第${序号}段"
    curl --silent --show-error --fail --location --connect-timeout 15 --max-time 900 \
        --range "${起点}-" -- "${链接}" </dev/null \
        | tee -- "${进度文件}" >> "${下载目录}/合并中" &
    下载进程=$!

    已下=${起点}
    while kill -0 "${下载进程}" 2>/dev/null; do
        已下=$(( 起点 + $(wc --bytes < "${进度文件}" 2>/dev/null || print 0) ))
        if [[ -z "${大小}" ]]; then
            回显 "  ${已下} 字节" >&2
        else
            百分比=$(( 已下 * 100 / 大小 ))
            [[ "${百分比}" -gt 100 ]] && 百分比=100
            条="${(l:${宽度}::=:)}"; 条[1,$(( 百分比 * 宽度 / 100 ))]="${(l:$(( 百分比 * 宽度 / 100 ))::#:)}"
            回显 "  [${条}] ${百分比}%" >&2
        fi
        sleep 0.3
    done
    wait "${下载进程}" 2>/dev/null
    状态码=$?
    if [[ "${状态码}" -ne 0 ]]; then
        rm --recursive --force -- "${下载目录}"
        回显 "下载失败（curl 退出码 ${状态码}）:${链接}" >&2
        return 1
    fi
    本地已下=$(( 起点 + $(wc --bytes < "${进度文件}") ))
    rm --force -- "${进度文件}"
    if [[ "${本地已下}" -le "${起点}" ]]; then
        回显 "下载停滞（已 ${已下} 字节）" >&2
        rm --recursive --force -- "${下载目录}"
        return 1
    fi
    起点="${本地已下}"
    回显 "  已下载 ${起点} 字节" >&2
    [[ -n "${大小}" && "${起点}" -ge "${大小}" ]] && break
    # 服务器若忽略 Range 返回 200，说明不支持续传（此时已拼出重复字节），立即报错而不是死循环
    段头=("${(@f)$(curl --silent --show-error --location --head --range "${起点}-" --connect-timeout 10 --max-time 30 -- "${链接}" </dev/null)}")
    段头="${(M)${(@)段头}:#Content-Range:*}"
    段头="${${段头#*Content-Range: }%%/*}"
    [[ "${段头}" == [0-9]## ]] || { 回显 "服务器不支持断点续传:${链接}" >&2; rm --recursive --force -- "${下载目录}"; return 1 }
    序号=$(( 序号 + 1 ))
done

mv --force -- "${下载目录}/合并中" "${目标}"
rm --recursive --force -- "${下载目录}"
回显 "  完成 ${起点} 字节" >&2
return 0
}

mkdir --parents "${软件目录}"
    

对于 文件名称 in "${(@k)资源链接[@]}"; 进行
    [[ -z "${文件名称}" ]] && 继续
    创建目录 "${软件目录}/临时"
    进入 "${软件目录}/临时"
    文件链接="${资源链接[${文件名称}]}"
    [[ -z "${文件链接}" ]] && 继续
    [[ -n "${文件名称[1]}" && "${文件名称[1]}" != - ]] || { 回显 "资源名称非法:${文件名称}" >&2; 退出 1 }
    if [[ -s "${软件目录}/临时/${文件名称}" ]]; then
        回显 "已下载，跳过:${文件名称}"
    elif 带进度下载 "${文件链接}" "${软件目录}/临时/${文件名称}"; then
        回显 "下载完成:${文件名称}"
    else
        退出 1
    fi
完成

配置部署

for 运行名称 运行路径 in "${(@kv)运行路径[@]}"; do
    mkdir --parents "${软件目录}/运行"
    if [[ -z "${运行路径}" ]]; then
        运行路径=
    elif [[ "${运行路径}" == /* ]]; then
        运行路径="${运行路径}"
    else
        运行路径='${目录}'"/${运行路径}"
    fi
    echo '#!/bin/env zsh' > "${软件目录}/运行/${运行名称}"
    echo '文件="$(realpath "$0")"' >> "${软件目录}/运行/${运行名称}"
    echo '运行="$(dirname "$文件")"' >> "${软件目录}/运行/${运行名称}"
    echo '目录="$(dirname "$运行")"' >> "${软件目录}/运行/${运行名称}"
    echo '列表="$(dirname "$目录")"' >> "${软件目录}/运行/${运行名称}"
    echo '名称="$(basename "$文件")"' >> "${软件目录}/运行/${运行名称}"
    for 软件名称 in "${运行依赖[@]}"; do
        [[ -z "${软件名称}" ]] && continue
        echo '导出 PATH="${列表}/'"${软件名称}"'/运行:$PATH"' >> "${软件目录}/运行/${运行名称}"
    done
    对于 软件名称 in "${动态链接[@]}"; 进行
        [[ -z "${软件名称}" ]] && 继续
        回显 '导出 LD_LIBRARY_PATH="${列表}/'"${软件名称}"'/共享:$LD_LIBRARY_PATH"' >> "${软件目录}/运行/${运行名称}"
    完成
    [[ -e "${软件目录}/容器/lib" ]] && 回显 '导出 LD_LIBRARY_PATH="${目录}/容器/lib:$LD_LIBRARY_PATH"' >> "${软件目录}/运行/${运行名称}"
    [[ -e "${软件目录}/数据" ]] && 回显 '导出 HOME="${目录}/数据"' >> "${软件目录}/运行/${运行名称}"
    [[ -f "${软件目录}/配置/${运行名称}" ]] && 回显 '导入 "${目录}/配置/${名称}"' >> "${软件目录}/运行/${运行名称}"
    if [[ -f "${软件目录}/钩子/${运行名称}" ]]; 那么
        回显 "${运行路径}"' "$@"' >> "${软件目录}/运行/${运行名称}"
        回显 '导入 "${目录}/钩子/${名称}"' >> "${软件目录}/运行/${运行名称}"
    否则
        [[ -z "${运行方式}" ]] && 回显 'exec "'"${运行路径}"'" "$@"' >> "${软件目录}/运行/${运行名称}"
        [[ -n "${运行方式}" ]] && 回显 '运行 '"${运行方式}"' "'"${运行路径}"'" "$@"' >> "${软件目录}/运行/${运行名称}"
    结束
    给予运行权限 "${软件目录}/运行/${运行名称}"
done

for 运行名称 in "${运行列表[@]}"; do
    ln --symbolic --force --relative "${软件目录}/运行/${运行名称}" "${数据}/软件/软件运行/${运行名称}"
done

[[ -n "${软件版本}" ]] && echo "${软件版本}" > "${软件目录}/版本"


echo "软件装载完成:${软件}"