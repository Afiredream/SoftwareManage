
软件名称=QQ
运行方式=exec
运行路径=容器/opt/QQ/qq
图标路径=容器/usr/share/icons/hicolor/512x512/apps/qq.png
运行依赖=()

运行环境() {

  export QT_IM_MODULE=fcitx
  export GTK_IM_MODULE=fcitx
  export XMODIFIERS=@im=fcitx

  运行参数+=(--enable-wayland-ime)
  运行参数+=(--ozone-platform-hint=auto)

}

更新检查() {
  ;
}

配置部署() {

  文件名称="linuxqq.deb"
  文件链接="https://qqdl.gtimg.cn/qqfile/QQNT/9.9.35/beta/1763096b/linuxqq_3.2.33-52892_amd64.deb"

  mkdir --parents "${临时目录}"
  mkdir --parents "${容器目录}"
  
  if [[ ! -f "${临时目录}/${文件名称}" ]];then
    cd "${临时目录}"
    wget --output-document="${文件名称}" "${文件链接}"
    ar x "${文件名称}"
    tar --extract --file data.tar.xz --directory "${容器目录}"
    tar --extract --file control.tar.gz --directory "${容器目录}"
    rm --force data.tar.xz
    rm --force debian-binary
    rm --force control.tar.gz
  fi

  if [[ ! -f "${软件目录}/${运行路径}" ]];then
    cd "${临时目录}"
    ar x "${文件名称}"
    tar --extract --file data.tar.xz --directory "${容器目录}"
    tar --extract --file control.tar.gz --directory "${容器目录}"
    rm --force data.tar.xz
    rm --force debian-binary
    rm --force control.tar.gz
  fi

}