#!/bin/ksh

软件名称=Rust

终端命令=(cargo rustc rustup)
运行路径[rustc]=数据/.cargo/bin/rustc
运行路径[cargo]=数据/.cargo/bin/cargo
运行路径[rustup]=数据/.cargo/bin/rustup
资源链接[sh.rustup.rs]=https://sh.rustup.rs


配置部署() {

cd "$ROOT"
mkdir --parents 数据

cd "$ROOT/临时"
chmod +x sh.rustup.rs
export HOME="$ROOT/数据"
./sh.rustup.rs

}