#!/bin/ksh

软件名称=Proton-dw
软件版本=11.0

typeset -A 资源链接
资源链接[Proton.tar.xz]=https://dawn.wine/dawn-winery/dwproton/releases/download/dwproton-11.0-12/dwproton-11.0-12-x86_64.tar.xz
终端命令=(proton-dw)
typeset -A 运行路径
运行路径[proton-dw]=软件/proton

配置部署() {

cd "$ROOT"
mkdir --parents 数据
mkdir --parents 配置
rm --recursive --force 软件

cd "$ROOT/临时"
tar --extract --file Proton.tar.* --directory .
mv dwproton* "$ROOT/软件"

cd "$ROOT/配置"
cat > proton-ge <<'EOF'
mkdir --parents "$PREFIX"
mkdir --parents "$PREFIX/drive_c/users"
export STEAM_COMPAT_DATA_PATH="$PREFIX"
export STEAM_COMPAT_CLIENT_INSTALL_PATH=/
ln --symbolic --force --relative --no-dereference "$PREFIX" "$PREFIX/pfx"
ln --symbolic --force --relative --no-dereference "$PREFIX/drive_c/users/Public" "$PREFIX/drive_c/users/steamuser"
set -- runinprefix "$@"
EOF

}