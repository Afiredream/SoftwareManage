#!/bin/env ksh

软件名称=zsh
软件版本=6.1.1

终端命令=(zsh)
运行路径[zsh]=软件/zsh
资源链接[zsh.tar.gz]=https://github.com/romkatv/zsh-bin/releases/download/v6.1.1/zsh-5.8-linux-x86_64.tar.gz


配置部署() {

cd "$ROOT"
mkdir --parents 软件
mkdir --parents 配置

cd "$ROOT/临时"
tar --extract --file zsh.tar.gz --directory "$ROOT/软件" --strip-components=1 bin/zsh 

cd "$ROOT/配置"
cat > zsh << 'TEXT'
export ZDOTDIR="$ROOT/配置"
TEXT
cat > .zshenv << 'TEXT'
alias 别名=alias
别名 如果=if
别名 结束=fi
别名 进入=cd
别名 对于=for
别名 否则=else
别名 退出=exit
别名 回显=echo
别名 运行=exec
别名 那么=then
别名 循环=while
别名 本地=local
别名 取消=unset
别名 打印=print
别名 配置=setopt
别名 导出=export
别名 导入=source
别名 函数=function
配置 aliases
TEXT
}