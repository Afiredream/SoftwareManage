#!/bin/env zsh

软件名称=钉钉
软件版本=8.3.1

运行列表=(钉钉)
运行路径[钉钉]=软件/com.alibabainc.dingtalk
资源链接[钉钉.deb]=https://dtapp-pub.dingtalk.com/dingtalk-desktop/xc_dingtalk_update/linux_deb/Release/com.alibabainc.dingtalk_8.3.1.261008001_amd64.deb

配置部署() {

进入 "${软件目录}"
创建目录 数据
创建目录 容器
创建目录 配置

进入 "${软件目录}/临时"
ar x 钉钉.deb
tar --extract --file data.tar.xz --directory "${软件目录}/容器"
magick "${软件目录}/容器/opt/apps/com.alibabainc.dingtalk/files/logo.ico[0]" "${软件目录}/系统/icons/${软件名称}.png"
ln --symbolic --force --relative --no-dereference "${软件目录}/容器"/opt/apps/com.alibabainc.dingtalk/files/*-Release.* "${软件目录}/软件"
删除文件 data.tar.xz
删除文件 debian-binary
删除文件 control.tar.xz

进入 "${软件目录}/配置"
cat > 钉钉 << '文本'
进入 "${目录}/软件"
导出 QT_IM_MODULE=fcitx
导出 GTK_IM_MODULE=fcitx
导出 XMODIFIERS=@im=fcitx
导出 LD_LIBRARY_PATH=/lib
数据="$(eval 回显 ~$USER)"
删除目录 "$HOME/Downloads"
配置符号链接 "${数据}/Downloads" "$HOME/Downloads"
文本

进入 "${软件目录}/系统"
cat > applications/钉钉.desktop << 文本
[Desktop Entry]
Type=Application
Name=钉钉
Exec=钉钉
Icon=钉钉
文本


}