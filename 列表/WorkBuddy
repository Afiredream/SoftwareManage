#!/bin/env zsh

软件名称=WorkBuddy
软件版本=5.5.4.38151288-1ca4889a

资源链接[WorkBuddy.deb]="https://download.codebuddy.cn/workbuddy/saas/linux-x64-deb/WorkBuddy-linux-x64-deb-${软件版本}.deb"

运行列表=(workbuddy codebuddy)
运行路径[workbuddy]=软件/workbuddy
运行路径[codebuddy]=软件/resources/app.asar.unpacked/cli/bin/codebuddy

配置部署() {

cd "${软件目录}"
mkdir --parents 容器
mkdir --parents 数据
mkdir --parents 配置
rm --recursive --force 系统
rm --recursive --force 软件

cd "${软件目录}/临时"
ar x WorkBuddy.deb
tar --extract --file data.tar.xz --directory "${软件目录}/容器"
rm --force data.tar.xz
rm --force control.tar.xz
rm --force debian-binary

cd "${软件目录}/配置"
cat > workbuddy << '文本'
export PATH="${目录}/软件/resources/runtime/node/bin:$PATH"
export PATH="${目录}/软件/resources/runtime/python/bin:$PATH"
文本
cat > codebuddy << '文本'
export PATH="${目录}/软件/resources/runtime/node/bin:$PATH"
export PATH="${目录}/软件/resources/runtime/python/bin:$PATH"
文本

cd "${软件目录}/容器"
desktop-file-edit --set-key=Exec --set-value=workbuddy usr/share/applications/workbuddy.desktop
applications usr/share/applications/workbuddy.desktop
icons usr/share/icons/hicolor/512x512/apps/workbuddy.png

cd "${软件目录}"
ln --symbolic --force --relative --no-dereference "${软件目录}/容器/opt/WorkBuddy" 软件

}
