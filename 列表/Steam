#!/bin/env zsh

软件名称=Steam
软件版本=1.0.0.87-3

运行列表=(steam)
运行路径[steam]=临时/Steam.AppImage
资源链接[Steam.AppImage]=https://github.com/ivan-hc/Steam-appimage/releases/download/1.0.0.87-3%402026-09-01_1788260048/Steam-1.0.0.87-3-anylinux-x86_64.AppImage

配置部署() {

进入 "${软件目录}"
创建目录 数据
创建目录 配置

进入 "${软件目录}/临时"
给予运行权限 Steam.AppImage

进入 "${软件目录}/配置"
cat > steam << '配置文本'
#!/bin/env zsh

游戏="${游戏:-$PWD}"

导出 XDG_CACHE_HOME="$HOME/.cache"
导出 XDG_CONFIG_HOME="${游戏}/config"
导出 XDG_DATA_HOME="$HOME/.local/share"
导出 XDG_STATE_HOME="$HOME/.local/state"

软件="$HOME/.steam/steam"
仓库="${软件}/steamapps"

图标="$XDG_DATA_HOME/icons"
运行="$XDG_DATA_HOME/applications"

删除 "${图标}"
删除 "${运行}"

创建目录 "${游戏}/steamapps"
创建目录 "${游戏}/applications"
创建目录 "${游戏}/icons/hicolor"

配置符号链接 "${游戏}/icons" "${图标}"
配置符号链接 "${游戏}/applications" "${运行}"

cat > "${游戏}/.desktop" << '文本'
[Desktop Entry]
Type=Application
Exec=steam steam://open/games
文本
chmod +x "${游戏}/.desktop"

cat > "${游戏}/.directory" << '文本'
[Desktop Entry]
Type=Directory
Icon=./icons/hicolor/scalable/apps/steam_icon_*
文本

cat > "${仓库}/libraryfolders.vdf" << 文本
"libraryfolders"
{
	"0"
	{
		"path"		"${软件}"
		"label"		""
		"contentid"		""
		"totalsize"		"0"
		"update_clean_bytes_tally"		"0"
		"time_last_update_verified"		"0"
		"apps"
		{
		}
	}
	"1"
	{
		"path"		"${游戏}"
		"label"		""
		"contentid"		""
		"totalsize"		"0"
		"update_clean_bytes_tally"		"0"
		"time_last_update_verified"		"0"
		"apps"
		{
		}
	}
}
文本

如果 [[ -d "${游戏}/icons/hicolor" ]]; 那么
	压栈 "${游戏}/icons/hicolor"
	如果 [[ ! -d "scalable" ]]; 那么
		[[ -e "16x16" ]] && 配置符号链接 "16x16" "scalable"
		[[ -e "32x32" ]] && 配置符号链接 "32x32" "scalable"
		[[ -e "48x48" ]] && 配置符号链接 "48x48" "scalable"
		[[ -e "64x64" ]] && 配置符号链接 "64x64" "scalable"
		[[ -e "128x128" ]] && 配置符号链接 "128x128" "scalable"
		[[ -e "160x160" ]] && 配置符号链接 "160x160" "scalable"
		[[ -e "256x256" ]] && 配置符号链接 "256x256" "scalable"
	结束
    弹栈
结束
配置文本

}