#!/bin/env zsh

软件名称=火狐浏览器

运行列表s=(firefox)
运行路径[firefox]=软件/firefox
资源链接[firefox.tar.xz]=https://download-installer.cdn.mozilla.net/pub/firefox/nightly/latest-mozilla-central-l10n/firefox-158.0a1.zh-CN.linux-x86_64.tar.xz

配置部署() {

进入 "${软件目录}"
创建目录 配置
创建目录 数据
删除目录 容器

进入 "${软件目录}/临时"
tar --extract --file firefox.tar.xz --directory .
[[ -d "$ROOT/软件" ]] || cp --recursive --force --no-target-directory firefox "$ROOT/软件"
cp --force "$ROOT/软件/browser/chrome/icons/default/default128.png" "$ROOT/系统/icons/${软件名称}.png"
rm --recursive --force firefox

进入 "${软件目录}/配置"
cat > firefox <<'EOF'
数据=$(eval 回显 ~$USER)
导出 XDG_CACHE_HOME="$Home/.cache"
导出 XDG_CONFIG_HOME="$Home/.config"
导出 XDG_DATA_HOME="$Home/.local/share"
导出 XDG_STATE_HOME="$Home/.local/state"
设置 -- "$@" -P Profile
EOF

进入 "${软件目录}/系统"
cat > autostart/firefox.desktop << TEXT
[Desktop Entry]
Type=Application
Exec=firefox
Name=${软件名称}
Icon=${软件名称}
TEXT
cat > applications/firefox.desktop << TEXT
[Desktop Entry]
Type=Application
Exec=firefox
Name=${软件名称}
Icon=${软件名称}
TEXT



}