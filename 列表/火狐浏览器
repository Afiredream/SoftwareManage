#!/bin/env zsh

软件名称=火狐浏览器

运行列表=(firefox)
运行路径[firefox]=软件/firefox
资源链接[火狐浏览器.tar.xz]=https://download-installer.cdn.mozilla.net/pub/firefox/nightly/latest-mozilla-central-l10n/firefox-161.0a1.zh-CN.linux-x86_64.tar.xz

配置部署() {

cd -- "${软件目录}" || return 1
command mkdir --parents -- 配置 数据
command rm --recursive --force -- 容器

cd -- "${软件目录}/临时" || return 1
tar --extract --file 火狐浏览器.tar.xz --directory .
[[ -d "${软件目录}/软件" ]] || command cp --recursive --force --no-target-directory firefox "${软件目录}/软件"
command mkdir --parents -- "${软件目录}/系统/icons"
command cp --force -- "${软件目录}/软件/browser/chrome/icons/default/default128.png" "${软件目录}/系统/icons/${软件名称}.png"
command rm --recursive --force -- firefox

cd -- "${软件目录}/配置" || return 1
cat > firefox <<'EOF'
Home=$(eval echo ~$USER)
export XDG_CACHE_HOME="$Home/.cache"
export XDG_CONFIG_HOME="$Home/.config"
export XDG_DATA_HOME="$Home/.local/share"
export XDG_STATE_HOME="$Home/.local/state"
set -- "$@" -P Profile
EOF

cd -- "${软件目录}/系统" || return 1
cat > autostart/firefox.desktop << TEXT
[Desktop Entry]
Type=Application
Exec=firefox
Name=${软件名称}
Icon=${软件名称}
TEXT
cat > applications/firefox.desktop << TEXT
[Desktop Entry]
Type=Application
Exec=firefox
Name=${软件名称}
Icon=${软件名称}
TEXT



}
